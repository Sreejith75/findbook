<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".template.config/template.json" />
    <File Path="CleanArchitecture.nuspec" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="src/FindBook.Core/FindBook.Core.csproj" />
    <Project Path="src/FindBook.Infrastructure/FindBook.Infrastructure.csproj" />
    <Project Path="src/FindBook.UseCases/FindBook.UseCases.csproj" />
    <Project Path="src/FindBook.Web/FindBook.Web.csproj" />
  </Folder>
  <Folder Name="/src/_aspire/">
    <Project Path="src/FindBook.AspireHost/FindBook.AspireHost.csproj" />
    <Project Path="src/FindBook.ServiceDefaults/FindBook.ServiceDefaults.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/FindBook.FunctionalTests/FindBook.FunctionalTests.csproj">
      <BuildDependency Project="src/FindBook.Web/FindBook.Web.csproj" />
    </Project>
    <Project Path="tests/FindBook.IntegrationTests/FindBook.IntegrationTests.csproj">
      <BuildDependency Project="src/FindBook.Infrastructure/FindBook.Infrastructure.csproj" />
    </Project>
    <Project Path="tests/FindBook.UnitTests/FindBook.UnitTests.csproj" />
  </Folder>
</Solution>
